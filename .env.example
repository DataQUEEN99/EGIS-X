# AEGIS-X Environment Configuration
PROJECT_NAME="AEGIS-X Cloud Failure Intelligence"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection (SQLite by default, or PostgreSQL string)
DATABASE_URL="sqlite:///./aegis_x.db"

# Safety Governance Defaults
SAFE_MODE_ENABLED=true
DRY_RUN_DEFAULT=true
HIGH_RISK_REQUIRES_APPROVAL=true
MAX_SCALE_LIMIT=10
VERIFICATION_WINDOW_SECONDS=30

# Telemetry & Diagnostics
DEFAULT_BASELINE_ANOMALY_THRESHOLD=2.5
TELEMETRY_WINDOW_MINUTES=15
